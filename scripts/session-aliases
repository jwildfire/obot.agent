#!/usr/bin/env bash
# session-aliases — generate the short `/s-*` aliases for the session-command family.
#
#   scripts/session-aliases                 # regenerate commands/ and install into ~/Documents/obot2
#   scripts/session-aliases --workspace DIR # install the workspace symlink somewhere else
#   scripts/session-aliases --check         # report drift, change nothing (exit 1 if drifted)
#   scripts/session-aliases --no-install    # regenerate commands/ only, skip the workspace symlink
#
# Every `skills/session-<x>/` gets a `commands/s-<x>.md` alias, so `/session-init`
# and `/s-init` are the same command. Both forms stay live: the alias file is a
# slash command that `@`-includes the canonical SKILL.md, so there is exactly one
# copy of the procedure and nothing to keep in sync.
#
# Why a command file and not a second symlink (measured on CLI 2.1.220, 2026-07-29):
#
#   - Slash commands resolve on the skill's DIRECTORY name; the frontmatter `name`
#     is ignored entirely for resolution.
#   - A second symlink pointing at an existing skill directory therefore does not
#     add an alias — it SHADOWS the original. Adding `probe-alias -> probe-real`
#     made `probe-real` disappear from the skill list (skills dedupe on resolved
#     path). That would have silently broken the long forms.
#   - An `aliases:` frontmatter key is not honoured for skills: `/pshort` answered
#     "Unknown command".
#   - `@path` inside a command file IS expanded by the harness before the model
#     runs (verified with `--tools ""`, i.e. no tools available at all), resolves
#     relative to the PROJECT ROOT, and follows symlinks. Trailing arguments are
#     appended automatically, so `/s-update fix the thing` reaches the skill
#     exactly as `/session-update fix the thing` does.
#
# The `@` target is `.claude/skills/<name>/SKILL.md` — the workspace install path,
# not this repo's path — so an alias works wherever the skill itself works. Install
# therefore also links any session-* skill the workspace is missing.
#
# Run the install from the MAIN clone, not a worktree: the symlinks it creates point
# at whatever copy of the repo it was run from, and a worktree gets deleted.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WORKSPACE="${OBOT_WORKSPACE:-$HOME/Documents/obot2}"
CHECK=false
INSTALL=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --check) CHECK=true; shift ;;
    --no-install) INSTALL=false; shift ;;
    -h|--help) sed -n 's/^# \{0,1\}//p' "${BASH_SOURCE[0]}" | sed -n '2,9p'; exit 0 ;;
    *) printf 'session-aliases: unknown argument %s\n' "$1" >&2; exit 1 ;;
  esac
done

drift=0
note() { printf '%s\n' "$1"; }

# Read a single frontmatter key from a SKILL.md (first match, value verbatim).
frontmatter() {
  awk -v key="$2" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside && index($0, key ":")==1 { sub(/^[^:]*:[ \t]*/, ""); print; exit }
  ' "$1"
}

render() {
  local skill="$1" short="$2" hint="$3"
  printf -- '---\n'
  printf -- 'description: "Short alias for /%s. Both forms load the same skill."\n' "$skill"
  [ -n "$hint" ] && printf -- 'argument-hint: %s\n' "$hint"
  printf -- '---\n\n'
  printf -- '@.claude/skills/%s/SKILL.md\n' "$skill"
}

mkdir -p "$REPO_DIR/commands"
generated=()

for dir in "$REPO_DIR"/skills/session-*/; do
  [ -f "$dir/SKILL.md" ] || continue
  skill="$(basename "$dir")"
  short="s-${skill#session-}"
  hint="$(frontmatter "$dir/SKILL.md" argument-hint)"
  target="$REPO_DIR/commands/$short.md"
  generated+=("$short.md")

  if [ -f "$target" ] && render "$skill" "$short" "$hint" | diff -q - "$target" >/dev/null 2>&1; then
    continue
  fi
  if $CHECK; then
    note "drift: commands/$short.md is missing or stale"
    drift=1
  else
    render "$skill" "$short" "$hint" > "$target"
    note "wrote commands/$short.md -> /$skill"
  fi
done

# Aliases whose skill was renamed or removed are stale; report them rather than
# deleting, so a removal is always a deliberate act (workspace no-delete rule).
for existing in "$REPO_DIR"/commands/s-*.md; do
  [ -e "$existing" ] || continue
  base="$(basename "$existing")"
  found=false
  for g in ${generated[@]+"${generated[@]}"}; do [ "$g" = "$base" ] && found=true; done
  $found || { note "orphan: commands/$base has no matching skills/session-* directory"; drift=1; }
done

# The @-include resolves through the workspace skill symlink, so a missing one
# means the alias would expand to nothing.
for g in ${generated[@]+"${generated[@]}"}; do
  skill="session-${g#s-}"; skill="${skill%.md}"
  [ -e "$WORKSPACE/.claude/skills/$skill" ] && continue
  if $CHECK || ! $INSTALL; then
    note "warn: $WORKSPACE/.claude/skills/$skill is missing — /${g%.md} would expand to nothing"
    drift=1
  else
    mkdir -p "$WORKSPACE/.claude/skills"
    ln -sfn "$(python3 -c 'import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))' \
      "$REPO_DIR/skills/$skill" "$WORKSPACE/.claude/skills")" "$WORKSPACE/.claude/skills/$skill"
    note "linked $WORKSPACE/.claude/skills/$skill"
  fi
done

if $INSTALL; then
  link="$WORKSPACE/.claude/commands"
  want="$REPO_DIR/commands"
  if [ -L "$link" ] && [ "$(cd "$(dirname "$link")" && cd "$(readlink "$link")" && pwd)" = "$want" ]; then
    :
  elif [ -e "$link" ] && [ ! -L "$link" ]; then
    note "error: $link exists and is not a symlink — leaving it alone"
    drift=1
  elif $CHECK; then
    note "drift: $link does not point at $want"
    drift=1
  else
    mkdir -p "$WORKSPACE/.claude"
    ln -sfn "$(python3 -c 'import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))' "$want" "$WORKSPACE/.claude")" "$link"
    note "linked $link -> $(readlink "$link")"
  fi
fi

if $CHECK; then
  [ "$drift" -eq 0 ] && note "ok: ${#generated[@]} aliases in sync" || note "check failed"
  exit "$drift"
fi
note "ok: ${#generated[@]} aliases"
