#!/usr/bin/env bash
# obot-navigator — launch (or locate) the standing 🧭🤖 obot-navigator session.
#
# The Navigator is the operating officer: @jwildfire's asks become requirements
# before they become work, every worker that closes gets a verdict, and the
# machinery everyone else works inside gets improved. The full contract is
# skills/navigator/SKILL.md; the design and his approval are D0017
# (jwildfire/obot.roadmap reports/decisions/2026-08-16-navigator-design).
#
# Usage:
#   obot-navigator                   # launch in the background (Remote Control on)
#   obot-navigator --model <model>   # model override (default: opus)
#   obot-navigator --preflight-only  # run checks and print the launch command only
#
# Reach the running session with `claude agents` / `claude attach <id>`, or from
# claude.ai/code and the Claude mobile app via Remote Control.
# Exit codes: 0 launched (or already running — id printed), 1 pre-flight failure.
#
# Three properties are copied deliberately from scripts/obot-prime, which works:
# launched from the workspace root so it inherits the workspace instructions, the
# skills overlay and the session-hub cache; bridged, because this is a role he
# talks to from a phone; and a singleton, because two officers writing
# requirements for the same ask is the failure mode worth designing out on day one.
#
# One deliberate difference: the jobs directory is overridable, so the singleton
# rule is exercised by scripts/test/obot-navigator.test.mjs rather than trusted.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# Workspace derivation, same rationale as obot-prime (obot.agent#60): from a
# linked worktree, dirname of the repo points into .claude/worktrees; the git
# common dir always resolves to the main clone. OBOT_WORKSPACE overrides.
if [ -n "${OBOT_WORKSPACE:-}" ]; then
  WORKSPACE="$OBOT_WORKSPACE"
elif GIT_COMMON_DIR="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
     && [ -n "$GIT_COMMON_DIR" ]; then
  WORKSPACE="$(cd "$(dirname "$(dirname "$GIT_COMMON_DIR")")" && pwd)"
else
  WORKSPACE="$(dirname "$REPO_DIR")"
fi

JOBS_DIR="${OBOT_JOBS_DIR:-$HOME/.claude/jobs}"
MODEL="opus"
PREFLIGHT_ONLY=0

fail() { echo "obot-navigator: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --model)          MODEL="$2"; shift 2 ;;
    --preflight-only) PREFLIGHT_ONLY=1; shift ;;
    -h|--help)        sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)                fail "unknown argument: $1" ;;
  esac
done

# ---- pre-flight -------------------------------------------------------------

if [ "$PREFLIGHT_ONLY" -eq 0 ]; then
  command -v claude >/dev/null 2>&1 || fail "claude CLI not on PATH"
fi

# Singleton rule: one 🧭🤖 at a time. Any non-done job counts as live — a standing
# session that thinks only on a trigger sits in 'blocked' between wakings, and
# treating that as dead would start a second officer every quiet hour.
RUNNING=$(python3 - "$JOBS_DIR" <<'PY'
import json, pathlib, sys
jobs = pathlib.Path(sys.argv[1])
for f in sorted(jobs.glob("*/state.json")) if jobs.is_dir() else []:
    try:
        s = json.loads(f.read_text())
    except Exception:
        continue
    if str(s.get("name", "")).startswith("\U0001f9ed") and s.get("state") != "done":
        print(f.parent.name, s.get("state"))
        break
PY
)
if [ -n "$RUNNING" ]; then
  set -- $RUNNING
  echo "obot-navigator: already running (job $1, state $2)"
  echo "obot-navigator: reach it with: claude attach $1  — or claude.ai/code / the phone"
  exit 0
fi

NAME="🧭🤖 obot-navigator"
CMD=(claude --bg --permission-mode auto --remote-control -n "$NAME")
CMD+=(--model "$MODEL")
CMD+=("/s-navigator")

if [ "$PREFLIGHT_ONLY" -eq 1 ]; then
  # Printed with %s rather than %q: %q escapes every non-ASCII byte, which turns
  # the session name into mojibake and makes the one line a reader checks
  # unreadable. Only arguments carrying whitespace need quoting.
  printf 'obot-navigator: would run (from %s):' "$WORKSPACE"
  for arg in "${CMD[@]}"; do
    case "$arg" in *[[:space:]]*) printf " '%s'" "$arg" ;; *) printf ' %s' "$arg" ;; esac
  done
  printf '\n'
  exit 0
fi

# Launch from the workspace root so the session gets the workspace CLAUDE.md, the
# .claude overlay (skills/commands), and the session-hub cache.
cd "$WORKSPACE"
exec "${CMD[@]}"
