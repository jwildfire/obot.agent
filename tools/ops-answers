#!/usr/bin/env node
// ops-answers — the decision answers @jwildfire has recorded, and what has
// happened to them (obot.agent#120).
//
// The one bounded read that answers "has he decided anything I haven't acted
// on?". A staged answer nobody watches is what cost him the evening of
// 2026-08-15, so the states here name their consumer:
//
//   captured   he clicked; nothing has seen it yet
//   delivered  the 🧭🤖 Navigator sweep announced it; an agent has it
//   applied    the artifact, the log and the index were updated — with evidence
//   superseded he answered again; the record is kept, not deleted
//
// Usage (from the workspace root):
//   obot.agent/tools/ops-answers pending [--json] [--exit-code]
//   obot.agent/tools/ops-answers deliver            # what the sweep calls
//   obot.agent/tools/ops-answers apply <id> --evidence <url> [--by <who>]
//   obot.agent/tools/ops-answers show <id>
//
// Run it as the bare path, from the workspace root. It is executable and carries its
// own `node` shebang, so a `bash ` prefix cannot work — and the habit of adding one
// is what broke `obot-merge` for two days (obot.agent#162, #180).
//
// <id> is anything this tool prints for an answer: the decision id (`D0014`), the
// artifact slug, or the record id. All three resolve.
//
//   OBOT_WORKSPACE  workspace root (default ~/Documents/obot2)
//   OBOT_HUB        obot.roadmap clone (default <workspace>/obot.roadmap)
//   --exit-code     1 if anything is pending, 2 if anything is overdue
//
// LOCAL ONLY, like everything in `.claude/ops/`: this prints his verbatim words
// to the terminal, which is the point — an agent applying a decision needs them
// — but nothing here is committed or published by this tool, and the artifact is
// the only place those words are ever meant to be quoted.
import path from 'node:path';
import process from 'node:process';

import {
  currentAnswers, pendingAnswers, deliverAnswers, markApplied, resolveAnswerRef,
  answersSection, ageMin, ago, OVERDUE_MIN, STORELESS,
} from './ops-dashboard/lib/answers.mjs';

const WS = path.resolve(process.env.OBOT_WORKSPACE || path.join(process.env.HOME ?? '', 'Documents/obot2'));
const HUB = path.resolve(process.env.OBOT_HUB || path.join(WS, 'obot.roadmap'));

const argv = process.argv.slice(2);
const cmd = argv[0] ?? 'pending';
const flags = {};
const positional = [];
for (let i = 1; i < argv.length; i++) {
  const a = argv[i];
  if (!a.startsWith('--')) { positional.push(a); continue; }
  const next = argv[i + 1];
  if (next && !next.startsWith('--')) { flags[a] = next; i++; } else flags[a] = true;
}
const flag = (name) => Boolean(flags[name]);
const value = (name) => (typeof flags[name] === 'string' ? flags[name] : null);

const line = (a) => {
  const min = ageMin(a.at);
  const overdue = min > OVERDUE_MIN && a.status !== 'applied' ? ' OVERDUE' : '';
  const qs = Object.entries(a.questions ?? {})
    .map(([id, q]) => `    ${id}${q.code ? ` (${q.code})` : ''}: ${q.verdict}`).join('\n');
  return [
    `${a.decisionId ?? a.artifact ?? a.id}  ${a.verdict}  [${a.status}${overdue}]  recorded ${(a.at || '').slice(0, 16).replace('T', ' ')} (${ago(min)} ago)`,
    `    artifact: ${a.artifact ?? '(none)'}${a.decisionId ? '' : `  — id lookup failed: ${a.decisionIdError ?? 'unknown'}`}`,
    qs,
    a.words ? `    words: ${a.words}` : '',
    (a.supersedes ?? []).length ? `    supersedes ${a.supersedes.length} earlier answer(s)${a.afterApplied ? ' — one of them was already APPLIED, so update the artifact rather than adding to it' : ''}` : '',
    (a.clicks ?? 1) > 1 ? `    clicked ${a.clicks} times — one decision` : '',
    `    id: ${a.id}`,
  ].filter(Boolean).join('\n');
};

function main() {
  if (cmd === 'pending' || cmd === 'list') {
    const items = cmd === 'list' ? currentAnswers(WS, { hub: HUB }) : pendingAnswers(WS, { hub: HUB });
    if (flag('--json')) {
      process.stdout.write(`${JSON.stringify({ workspace: WS, hub: HUB, pending: items }, null, 2)}\n`);
    } else if (!items.length) {
      // A store that is not on this machine is not a store whose answers were all
      // applied. `.claude/ops/answers/` is local-only and no clone brings it, so on the
      // new laptop this printed a verdict on a directory nobody opened — into the
      // bundle 🎩🤖 prime reads on every cold turn to decide whether @jwildfire is
      // waiting on anything. The mark already existed and the sweep already read it;
      // this reader did not (jwildfire/obot.roadmap#223).
      process.stdout.write(items[STORELESS]
        ? 'no answer store on this machine yet — nothing has been recorded here, so nothing can be pending. It appears the first time you answer a decision on the dashboard.\n'
        : 'nothing pending — every answer he has recorded has been applied.\n');
    } else {
      process.stdout.write(`${items.length} answer(s) he has recorded and nobody has applied:\n\n${items.map(line).join('\n\n')}\n\nApply one, then: ops-answers apply <id> --evidence <url> --by <who>\n  <id> is any id above — the decision id on the first line, the slug, or the record id.\n`);
    }
    if (flag('--exit-code')) {
      const overdue = items.some((a) => ageMin(a.at) > OVERDUE_MIN);
      // 0 is what a caller branches on to mean "nothing is waiting on him", and a
      // storeless read has not established that. 3 rather than 1 so a caller can still
      // tell "he is waiting" from "nobody looked".
      if (!items.length && items[STORELESS]) process.exit(3);
      process.exit(overdue ? 2 : (items.length ? 1 : 0));
    }
    return;
  }

  if (cmd === 'deliver') {
    const { delivered, events } = deliverAnswers(WS, { hub: HUB });
    process.stdout.write(delivered.length
      ? `${events.map((e) => e.line).join('\n')}\n`
      : 'nothing new to hand over.\n');
    return;
  }

  if (cmd === 'section') { process.stdout.write(answersSection(pendingAnswers(WS, { hub: HUB }))); return; }

  // `apply` takes whatever `pending` printed. It used to take the record key alone,
  // which `pending` never shows, so the documented way to clear an OVERDUE flag
  // answered the displayed id with "no answer D0014" (obot.agent#180).
  if (cmd === 'apply') {
    const id = positional[0];
    const evidence = value('--evidence');
    if (!id || !evidence) {
      process.stderr.write('usage: ops-answers apply <id> --evidence <url> [--by <who>]\n'
        + '<id> is anything this tool prints for the answer: the decision id (D0014), the\n'
        + 'artifact slug, or the record id.\n'
        + 'evidence is required: "applied" means the artifact changed and here is where to see it.\n');
      process.exit(2);
    }
    const found = resolveAnswerRef(WS, id, { hub: HUB });
    if (!found.record) {
      // Ambiguity is said out loud with its candidates. Denying the answer exists is
      // what taught a reader to stop believing the flag.
      process.stderr.write(`${found.reason}\n`);
      for (const a of found.candidates) {
        process.stderr.write(`  ${a.id}  ${a.decisionId ?? a.artifact ?? ''}  [${a.status}]\n`);
      }
      process.exit(1);
    }
    if (found.alreadyApplied) {
      process.stdout.write(`already applied ${(found.record.appliedAt || '').slice(0, 16).replace('T', ' ')}`
        + ` by ${found.record.appliedBy ?? 'someone'} — ${found.record.evidence ?? 'no evidence recorded'}\n`
        + 're-stamping with the evidence you gave; the earlier stamp stays in its history.\n');
    }
    const rec = markApplied(WS, id, { by: value('--by') ?? 'an agent', evidence, hub: HUB });
    process.stdout.write(`${rec.decisionId ?? rec.artifact} applied — ${evidence}\n`);
    return;
  }

  if (cmd === 'show') {
    const found = resolveAnswerRef(WS, positional[0], { hub: HUB });
    const rec = found.record ?? found.candidates[0];
    if (!rec) { process.stderr.write(`${found.reason}\n`); process.exit(1); }
    if (found.candidates.length > 1) {
      process.stderr.write(`${found.reason} — showing the newest\n`);
    }
    process.stdout.write(`${JSON.stringify(rec, null, 2)}\n`);
    return;
  }

  process.stderr.write('usage: ops-answers pending|list|deliver|apply|show|section — see the header of this file\n');
  process.exit(2);
}

main();
